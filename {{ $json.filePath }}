[{"filePath":"src/modules/banks/httpServices.js","fileContent":"import { appClientMethods, deriveErrorMessage } from '~/core/http.client';\n\n/**\n * @param {object} params - The export configuration.\n * @param {function} onSuccess - Callback for successful response.\n * @param {function} onError - Callback for error response.\n */\nexport const requestTransactionExport = (params, onSuccess, onError) => {\n  appClientMethods.post('/banks/transactions/export', params)\n    .then(res => onSuccess(res.data))\n    .catch(err => onError(deriveErrorMessage(err)));\n};\n\n/**\n * @param {object} params - Pagination and filter parameters.\n * @param {function} onSuccess - Callback for successful response.\n * @param {function} onError - Callback for error response.\n */\nexport const getExportHistory = (params, onSuccess, onError) => {\n  appClientMethods.get('/banks/transactions/export/history', { params })\n    .then(res => onSuccess(res.data))\n    .catch(err => onError(deriveErrorMessage(err)));\n};\n\n/**\n * @param {string} exportId - The ID of the export file to download.\n * @param {function} onSuccess - Callback for successful response.\n * @param {function} onError - Callback for error response.\n */\nexport const downloadExportedFile = (exportId, onSuccess, onError) => {\n  appClientMethods.get(`/banks/transactions/export/download/${exportId}`, { responseType: 'blob' })\n    .then(res => onSuccess(res))\n    .catch(err => onError(deriveErrorMessage(err)));\n};\n\n/**\n * @param {function} onSuccess - Callback for successful response.\n * @param {function} onError - Callback for error response.\n */\nexport const getBankAccounts = (onSuccess, onError) => {\n  appClientMethods.get('/banks/accounts')\n    .then(res => onSuccess(res.data))\n    .catch(err => onError(deriveErrorMessage(err)));\n};\n\n/**\n * @param {function} onSuccess - Callback for successful response.\n * @param {function} onError - Callback for error response.\n */\nexport const getTransactionTypes = (onSuccess, onError) => {\n  appClientMethods.get('/transactions/types')\n    .then(res => onSuccess(res.data))\n    .catch(err => onError(deriveErrorMessage(err)));\n};\n","action":"CREATE","type":"unknown","raw":{"filePath":"src/modules/banks/httpServices.js","action":"CREATE","content":"import { appClientMethods, deriveErrorMessage } from '~/core/http.client';\n\n/**\n * @param {object} params - The export configuration.\n * @param {function} onSuccess - Callback for successful response.\n * @param {function} onError - Callback for error response.\n */\nexport const requestTransactionExport = (params, onSuccess, onError) => {\n  appClientMethods.post('/banks/transactions/export', params)\n    .then(res => onSuccess(res.data))\n    .catch(err => onError(deriveErrorMessage(err)));\n};\n\n/**\n * @param {object} params - Pagination and filter parameters.\n * @param {function} onSuccess - Callback for successful response.\n * @param {function} onError - Callback for error response.\n */\nexport const getExportHistory = (params, onSuccess, onError) => {\n  appClientMethods.get('/banks/transactions/export/history', { params })\n    .then(res => onSuccess(res.data))\n    .catch(err => onError(deriveErrorMessage(err)));\n};\n\n/**\n * @param {string} exportId - The ID of the export file to download.\n * @param {function} onSuccess - Callback for successful response.\n * @param {function} onError - Callback for error response.\n */\nexport const downloadExportedFile = (exportId, onSuccess, onError) => {\n  appClientMethods.get(`/banks/transactions/export/download/${exportId}`, { responseType: 'blob' })\n    .then(res => onSuccess(res))\n    .catch(err => onError(deriveErrorMessage(err)));\n};\n\n/**\n * @param {function} onSuccess - Callback for successful response.\n * @param {function} onError - Callback for error response.\n */\nexport const getBankAccounts = (onSuccess, onError) => {\n  appClientMethods.get('/banks/accounts')\n    .then(res => onSuccess(res.data))\n    .catch(err => onError(deriveErrorMessage(err)));\n};\n\n/**\n * @param {function} onSuccess - Callback for successful response.\n * @param {function} onError - Callback for error response.\n */\nexport const getTransactionTypes = (onSuccess, onError) => {\n  appClientMethods.get('/transactions/types')\n    .then(res => onSuccess(res.data))\n    .catch(err => onError(deriveErrorMessage(err)));\n};\n"},"repairedBlock":false,"fileName":"httpServices.js"},{"filePath":"src/modules/banks/components/ExportTransactionsButton.jsx","fileContent":"import React, { useState } from 'react';\nimport { Button } from 'antd';\nimport { DownloadOutlined } from '@ant-design/icons';\nimport TransactionExportModal from '../TransactionExportModal';\n\nconst ExportTransactionsButton = ({ selectedBankIds = [] }) => {\n  const [isModalVisible, setIsModalVisible] = useState(false);\n\n  const showModal = () => {\n    setIsModalVisible(true);\n  };\n\n  const handleClose = () => {\n    setIsModalVisible(false);\n  };\n\n  return (\n    <>\n      <Button\n        icon={<DownloadOutlined />}\n        onClick={showModal}\n        type=\"primary\"\n        className=\"bg-[var(--primaryColor)] hover:bg-blue-700\"\n      >\n        Export Transactions\n      </Button>\n      <TransactionExportModal\n        visible={isModalVisible}\n        onClose={handleClose}\n        initialSelectedBankIds={selectedBankIds}\n      />\n    </>\n  );\n};\n\nexport default ExportTransactionsButton;\n","action":"CREATE","type":"unknown","raw":{"filePath":"src/modules/banks/components/ExportTransactionsButton.jsx","action":"CREATE","content":"import React, { useState } from 'react';\nimport { Button } from 'antd';\nimport { DownloadOutlined } from '@ant-design/icons';\nimport TransactionExportModal from '../TransactionExportModal';\n\nconst ExportTransactionsButton = ({ selectedBankIds = [] }) => {\n  const [isModalVisible, setIsModalVisible] = useState(false);\n\n  const showModal = () => {\n    setIsModalVisible(true);\n  };\n\n  const handleClose = () => {\n    setIsModalVisible(false);\n  };\n\n  return (\n    <>\n      <Button\n        icon={<DownloadOutlined />}\n        onClick={showModal}\n        type=\"primary\"\n        className=\"bg-[var(--primaryColor)] hover:bg-blue-700\"\n      >\n        Export Transactions\n      </Button>\n      <TransactionExportModal\n        visible={isModalVisible}\n        onClose={handleClose}\n        initialSelectedBankIds={selectedBankIds}\n      />\n    </>\n  );\n};\n\nexport default ExportTransactionsButton;\n"},"repairedBlock":false,"fileName":"ExportTransactionsButton.jsx"},{"filePath":"src/modules/banks/TransactionExportModal.jsx","fileContent":"import React, { useState, useEffect } from 'react';\nimport { Modal, Form, DatePicker, Select, Radio, Button, Spin, notification } from 'antd';\nimport { requestTransactionExport, getBankAccounts, getTransactionTypes } from './httpServices';\n\nconst { RangePicker } = DatePicker;\nconst { Option } = Select;\n\nconst TransactionExportModal = ({ visible, onClose, initialSelectedBankIds }) => {\n  const [form] = Form.useForm();\n  const [loading, setLoading] = useState(false);\n  const [bankAccounts, setBankAccounts] = useState([]);\n  const [transactionTypes, setTransactionTypes] = useState([]);\n\n  useEffect(() => {\n    if (visible) {\n      // Fetch dynamic data for form selects\n      getBankAccounts(\n        (data) => setBankAccounts(data.accounts || []),\n        (err) => notification.error({ message: 'Error fetching accounts', description: err })\n      );\n      getTransactionTypes(\n        (data) => setTransactionTypes(data.types || []),\n        (err) => notification.error({ message: 'Error fetching transaction types', description: err })\n      );\n      // Set initial values from props\n      form.setFieldsValue({ bankAccountIds: initialSelectedBankIds });\n    } else {\n      form.resetFields();\n    }\n  }, [visible, initialSelectedBankIds, form]);\n\n  const handleExport = (values) => {\n    setLoading(true);\n    const params = {\n      ...values,\n      dateRange: {\n        from: values.dateRange[0].format('YYYY-MM-DD'),\n        to: values.dateRange[1].format('YYYY-MM-DD'),\n      },\n    };\n\n    requestTransactionExport(\n      params,\n      (data) => {\n        setLoading(false);\n        notification.success({\n          message: 'Export Started',\n          description: 'Your transaction export is being processed. You will receive an email notification when it is ready for download.',\n        });\n        onClose();\n      },\n      (err) => {\n        setLoading(false);\n        notification.error({ message: 'Export Failed', description: err });\n      }\n    );\n  };\n\n  return (\n    <Modal\n      title=\"Export Transactions\"\n      open={visible}\n      onCancel={onClose}\n      footer={null}\n      width={600}\n      className=\"text-[var(--textWhite)]\"\n    >\n      <Spin spinning={loading} tip=\"Processing export request...\">\n        <Form form={form} layout=\"vertical\" onFinish={handleExport} className=\"mt-6\">\n          <Form.Item name=\"dateRange\" label=\"Select Date Range\" rules={[{ required: true, message: 'Please select a date range!' }]}>\n            <RangePicker className=\"w-full\" />\n          </Form.Item>\n\n          <Form.Item name=\"format\" label=\"Export Format\" initialValue=\"csv\" rules={[{ required: true }]}>\n            <Radio.Group>\n              <Radio.Button value=\"csv\">CSV</Radio.Button>\n              <Radio.Button value=\"pdf\">PDF</Radio.Button>\n              <Radio.Button value=\"xlsx\">Excel</Radio.Button>\n            </Radio.Group>\n          </Form.Item>\n\n          <Form.Item name=\"transactionTypeIds\" label=\"Transaction Types (optional)\">\n            <Select mode=\"multiple\" allowClear placeholder=\"All types\" options={transactionTypes.map(t => ({label: t.name, value: t.id}))} />\n          </Form.Item>\n\n          <Form.Item name=\"bankAccountIds\" label=\"Bank Accounts\" rules={[{ required: true, message: 'Please select at least one bank account!' }]}>\n            <Select mode=\"multiple\" allowClear placeholder=\"Select bank accounts\" options={bankAccounts.map(b => ({label: `${b.name} - ${b.accountNumber}`, value: b.id}))} />\n          </Form.Item>\n\n          <Form.Item className=\"text-right mt-8\">\n            <Button key=\"back\" onClick={onClose} className=\"mr-2\">\n              Cancel\n            </Button>\n            <Button key=\"submit\" type=\"primary\" htmlType=\"submit\" className=\"bg-[var(--primaryColor)]\">\n              Request Export\n            </Button>\n          </Form.Item>\n        </Form>\n      </Spin>\n    </Modal>\n  );\n};\n\nexport default TransactionExportModal;\n","action":"CREATE","type":"unknown","raw":{"filePath":"src/modules/banks/TransactionExportModal.jsx","action":"CREATE","content":"import React, { useState, useEffect } from 'react';\nimport { Modal, Form, DatePicker, Select, Radio, Button, Spin, notification } from 'antd';\nimport { requestTransactionExport, getBankAccounts, getTransactionTypes } from './httpServices';\n\nconst { RangePicker } = DatePicker;\nconst { Option } = Select;\n\nconst TransactionExportModal = ({ visible, onClose, initialSelectedBankIds }) => {\n  const [form] = Form.useForm();\n  const [loading, setLoading] = useState(false);\n  const [bankAccounts, setBankAccounts] = useState([]);\n  const [transactionTypes, setTransactionTypes] = useState([]);\n\n  useEffect(() => {\n    if (visible) {\n      // Fetch dynamic data for form selects\n      getBankAccounts(\n        (data) => setBankAccounts(data.accounts || []),\n        (err) => notification.error({ message: 'Error fetching accounts', description: err })\n      );\n      getTransactionTypes(\n        (data) => setTransactionTypes(data.types || []),\n        (err) => notification.error({ message: 'Error fetching transaction types', description: err })\n      );\n      // Set initial values from props\n      form.setFieldsValue({ bankAccountIds: initialSelectedBankIds });\n    } else {\n      form.resetFields();\n    }\n  }, [visible, initialSelectedBankIds, form]);\n\n  const handleExport = (values) => {\n    setLoading(true);\n    const params = {\n      ...values,\n      dateRange: {\n        from: values.dateRange[0].format('YYYY-MM-DD'),\n        to: values.dateRange[1].format('YYYY-MM-DD'),\n      },\n    };\n\n    requestTransactionExport(\n      params,\n      (data) => {\n        setLoading(false);\n        notification.success({\n          message: 'Export Started',\n          description: 'Your transaction export is being processed. You will receive an email notification when it is ready for download.',\n        });\n        onClose();\n      },\n      (err) => {\n        setLoading(false);\n        notification.error({ message: 'Export Failed', description: err });\n      }\n    );\n  };\n\n  return (\n    <Modal\n      title=\"Export Transactions\"\n      open={visible}\n      onCancel={onClose}\n      footer={null}\n      width={600}\n      className=\"text-[var(--textWhite)]\"\n    >\n      <Spin spinning={loading} tip=\"Processing export request...\">\n        <Form form={form} layout=\"vertical\" onFinish={handleExport} className=\"mt-6\">\n          <Form.Item name=\"dateRange\" label=\"Select Date Range\" rules={[{ required: true, message: 'Please select a date range!' }]}>\n            <RangePicker className=\"w-full\" />\n          </Form.Item>\n\n          <Form.Item name=\"format\" label=\"Export Format\" initialValue=\"csv\" rules={[{ required: true }]}>\n            <Radio.Group>\n              <Radio.Button value=\"csv\">CSV</Radio.Button>\n              <Radio.Button value=\"pdf\">PDF</Radio.Button>\n              <Radio.Button value=\"xlsx\">Excel</Radio.Button>\n            </Radio.Group>\n          </Form.Item>\n\n          <Form.Item name=\"transactionTypeIds\" label=\"Transaction Types (optional)\">\n            <Select mode=\"multiple\" allowClear placeholder=\"All types\" options={transactionTypes.map(t => ({label: t.name, value: t.id}))} />\n          </Form.Item>\n\n          <Form.Item name=\"bankAccountIds\" label=\"Bank Accounts\" rules={[{ required: true, message: 'Please select at least one bank account!' }]}>\n            <Select mode=\"multiple\" allowClear placeholder=\"Select bank accounts\" options={bankAccounts.map(b => ({label: `${b.name} - ${b.accountNumber}`, value: b.id}))} />\n          </Form.Item>\n\n          <Form.Item className=\"text-right mt-8\">\n            <Button key=\"back\" onClick={onClose} className=\"mr-2\">\n              Cancel\n            </Button>\n            <Button key=\"submit\" type=\"primary\" htmlType=\"submit\" className=\"bg-[var(--primaryColor)]\">\n              Request Export\n            </Button>\n          </Form.Item>\n        </Form>\n      </Spin>\n    </Modal>\n  );\n};\n\nexport default TransactionExportModal;\n"},"repairedBlock":false,"fileName":"TransactionExportModal.jsx"},{"filePath":"src/modules/banks/ExportHistory.jsx","fileContent":"import React, { useState, useEffect } from 'react';\nimport { Grid, GridColumn as Column } from '@progress/kendo-react-grid';\nimport { process } from '@progress/kendo-data-query';\nimport { Button, Tag, notification } from 'antd';\nimport { DownloadOutlined, SyncOutlined, CheckCircleOutlined, CloseCircleOutlined } from '@ant-design/icons';\nimport { getExportHistory, downloadExportedFile } from './httpServices';\nimport fileSaver from 'file-saver';\n\nconst ExportHistory = () => {\n  const [history, setHistory] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [dataState, setDataState] = useState({ skip: 0, take: 10 });\n\n  const fetchHistory = () => {\n    setLoading(true);\n    getExportHistory(\n      { ...dataState },\n      (data) => {\n        setHistory(data.items || []);\n        setLoading(false);\n      },\n      (err) => {\n        notification.error({ message: 'Failed to load export history', description: err });\n        setLoading(false);\n      }\n    );\n  };\n\n  useEffect(() => {\n    fetchHistory();\n  }, [dataState]);\n\n  const handleDownload = (exportId, filename) => {\n    notification.info({ message: 'Preparing Download', description: `Your file ${filename} will begin downloading shortly.` });\n    downloadExportedFile(\n      exportId,\n      (response) => {\n        fileSaver.saveAs(new Blob([response.data]), filename);\n      },\n      (err) => {\n        notification.error({ message: 'Download Failed', description: err });\n      }\n    );\n  };\n\n  const StatusCell = (props) => {\n    const status = props.dataItem.status;\n    let tag;\n    switch (status) {\n      case 'COMPLETED':\n        tag = <Tag icon={<CheckCircleOutlined />} color=\"success\">Completed</Tag>;\n        break;\n      case 'PROCESSING':\n        tag = <Tag icon={<SyncOutlined spin />} color=\"processing\">Processing</Tag>;\n        break;\n      case 'FAILED':\n        tag = <Tag icon={<CloseCircleOutlined />} color=\"error\">Failed</Tag>;\n        break;\n      default:\n        tag = <Tag color=\"default\">{status}</Tag>;\n    }\n    return <td>{tag}</td>;\n  };\n\n  const ActionCell = (props) => {\n    const { status, id, filename } = props.dataItem;\n    return (\n      <td>\n        {status === 'COMPLETED' && (\n          <Button\n            icon={<DownloadOutlined />}\n            onClick={() => handleDownload(id, filename)}\n            size=\"small\"\n          >\n            Download\n          </Button>\n        )}\n      </td>\n    );\n  };\n\n  return (\n    <div className=\"p-6 bg-[var(--bodyBg)] text-[var(--textWhite)]\">\n      <h1 className=\"text-2xl font-semibold mb-4\">Transaction Export History</h1>\n      <Grid\n        data={process(history, dataState)}\n        pageable={true}\n        sortable={true}\n        filterable={true}\n        onDataStateChange={(e) => setDataState(e.dataState)}\n        {...dataState}\n        style={{ height: '70vh' }}\n      >\n        <Column field=\"createdAt\" title=\"Requested At\" filter=\"date\" format=\"{0:g}\" width=\"200px\" />\n        <Column field=\"format\" title=\"Format\" width=\"100px\" />\n        <Column field=\"dateRange\" title=\"Date Range\" />\n        <Column field=\"status\" title=\"Status\" cell={StatusCell} width=\"150px\" />\n        <Column title=\"Actions\" cell={ActionCell} width=\"150px\" filterable={false} sortable={false} />\n      </Grid>\n    </div>\n  );\n};\n\nexport default ExportHistory;\n","action":"CREATE","type":"unknown","raw":{"filePath":"src/modules/banks/ExportHistory.jsx","action":"CREATE","content":"import React, { useState, useEffect } from 'react';\nimport { Grid, GridColumn as Column } from '@progress/kendo-react-grid';\nimport { process } from '@progress/kendo-data-query';\nimport { Button, Tag, notification } from 'antd';\nimport { DownloadOutlined, SyncOutlined, CheckCircleOutlined, CloseCircleOutlined } from '@ant-design/icons';\nimport { getExportHistory, downloadExportedFile } from './httpServices';\nimport fileSaver from 'file-saver';\n\nconst ExportHistory = () => {\n  const [history, setHistory] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [dataState, setDataState] = useState({ skip: 0, take: 10 });\n\n  const fetchHistory = () => {\n    setLoading(true);\n    getExportHistory(\n      { ...dataState },\n      (data) => {\n        setHistory(data.items || []);\n        setLoading(false);\n      },\n      (err) => {\n        notification.error({ message: 'Failed to load export history', description: err });\n        setLoading(false);\n      }\n    );\n  };\n\n  useEffect(() => {\n    fetchHistory();\n  }, [dataState]);\n\n  const handleDownload = (exportId, filename) => {\n    notification.info({ message: 'Preparing Download', description: `Your file ${filename} will begin downloading shortly.` });\n    downloadExportedFile(\n      exportId,\n      (response) => {\n        fileSaver.saveAs(new Blob([response.data]), filename);\n      },\n      (err) => {\n        notification.error({ message: 'Download Failed', description: err });\n      }\n    );\n  };\n\n  const StatusCell = (props) => {\n    const status = props.dataItem.status;\n    let tag;\n    switch (status) {\n      case 'COMPLETED':\n        tag = <Tag icon={<CheckCircleOutlined />} color=\"success\">Completed</Tag>;\n        break;\n      case 'PROCESSING':\n        tag = <Tag icon={<SyncOutlined spin />} color=\"processing\">Processing</Tag>;\n        break;\n      case 'FAILED':\n        tag = <Tag icon={<CloseCircleOutlined />} color=\"error\">Failed</Tag>;\n        break;\n      default:\n        tag = <Tag color=\"default\">{status}</Tag>;\n    }\n    return <td>{tag}</td>;\n  };\n\n  const ActionCell = (props) => {\n    const { status, id, filename } = props.dataItem;\n    return (\n      <td>\n        {status === 'COMPLETED' && (\n          <Button\n            icon={<DownloadOutlined />}\n            onClick={() => handleDownload(id, filename)}\n            size=\"small\"\n          >\n            Download\n          </Button>\n        )}\n      </td>\n    );\n  };\n\n  return (\n    <div className=\"p-6 bg-[var(--bodyBg)] text-[var(--textWhite)]\">\n      <h1 className=\"text-2xl font-semibold mb-4\">Transaction Export History</h1>\n      <Grid\n        data={process(history, dataState)}\n        pageable={true}\n        sortable={true}\n        filterable={true}\n        onDataStateChange={(e) => setDataState(e.dataState)}\n        {...dataState}\n        style={{ height: '70vh' }}\n      >\n        <Column field=\"createdAt\" title=\"Requested At\" filter=\"date\" format=\"{0:g}\" width=\"200px\" />\n        <Column field=\"format\" title=\"Format\" width=\"100px\" />\n        <Column field=\"dateRange\" title=\"Date Range\" />\n        <Column field=\"status\" title=\"Status\" cell={StatusCell} width=\"150px\" />\n        <Column title=\"Actions\" cell={ActionCell} width=\"150px\" filterable={false} sortable={false} />\n      </Grid>\n    </div>\n  );\n};\n\nexport default ExportHistory;\n"},"repairedBlock":false,"fileName":"ExportHistory.jsx"},{"filePath":"src/modules/banks/BankList.jsx","fileContent":"import React, { useState, useEffect } from 'react';\nimport { Grid, GridColumn as Column } from '@progress/kendo-react-grid';\nimport { process } from '@progress/kendo-data-query';\nimport { getBankAccounts } from './httpServices'; // Assuming this service exists\nimport ExportTransactionsButton from './components/ExportTransactionsButton';\n\nconst BankList = () => {\n  const [banks, setBanks] = useState([]);\n  const [dataState, setDataState] = useState({ skip: 0, take: 10 });\n  const [selectedRows, setSelectedRows] = useState(new Set());\n\n  useEffect(() => {\n    getBankAccounts(\n      (data) => setBanks(data.accounts || []),\n      (err) => console.error('Failed to fetch banks:', err)\n    );\n  }, []);\n\n  const handleSelectionChange = (event) => {\n    const newSelected = new Set(selectedRows);\n    if (newSelected.has(event.dataItem.id)) {\n      newSelected.delete(event.dataItem.id);\n    } else {\n      newSelected.add(event.dataItem.id);\n    }\n    setSelectedRows(newSelected);\n  };\n\n  return (\n    <div className=\"p-6 bg-[var(--bodyBg)] text-[var(--textWhite)]\">\n      <div className=\"flex justify-between items-center mb-4\">\n        <h1 className=\"text-2xl font-semibold\">Bank Accounts</h1>\n        <ExportTransactionsButton selectedBankIds={Array.from(selectedRows)} />\n      </div>\n      <p className=\"mb-4 text-gray-400\">Select one or more banks from the list to include them in the export.</p>\n      <Grid\n        data={process(banks.map(item => ({...item, selected: selectedRows.has(item.id)})), dataState)}\n        pageable={true}\n        sortable={true}\n        {...dataState}\n        onDataStateChange={(e) => setDataState(e.dataState)}\n        style={{ height: '70vh' }}\n        selectable={{ enabled: true, mode: 'multiple', checkboxOnly: true }}\n        onSelectionChange={handleSelectionChange}\n        dataItemKey=\"id\"\n      >\n        <Column field=\"selected\" width=\"50px\" />\n        <Column field=\"name\" title=\"Bank Name\" />\n        <Column field=\"accountNumber\" title=\"Account Number\" />\n        <Column field=\"balance\" title=\"Current Balance\" format=\"{0:c}\" />\n        <Column field=\"currency\" title=\"Currency\" />\n      </Grid>\n    </div>\n  );\n};\n\nexport default BankList;\n","action":"UPDATE","type":"unknown","raw":{"filePath":"src/modules/banks/BankList.jsx","action":"UPDATE","content":"import React, { useState, useEffect } from 'react';\nimport { Grid, GridColumn as Column } from '@progress/kendo-react-grid';\nimport { process } from '@progress/kendo-data-query';\nimport { getBankAccounts } from './httpServices'; // Assuming this service exists\nimport ExportTransactionsButton from './components/ExportTransactionsButton';\n\nconst BankList = () => {\n  const [banks, setBanks] = useState([]);\n  const [dataState, setDataState] = useState({ skip: 0, take: 10 });\n  const [selectedRows, setSelectedRows] = useState(new Set());\n\n  useEffect(() => {\n    getBankAccounts(\n      (data) => setBanks(data.accounts || []),\n      (err) => console.error('Failed to fetch banks:', err)\n    );\n  }, []);\n\n  const handleSelectionChange = (event) => {\n    const newSelected = new Set(selectedRows);\n    if (newSelected.has(event.dataItem.id)) {\n      newSelected.delete(event.dataItem.id);\n    } else {\n      newSelected.add(event.dataItem.id);\n    }\n    setSelectedRows(newSelected);\n  };\n\n  return (\n    <div className=\"p-6 bg-[var(--bodyBg)] text-[var(--textWhite)]\">\n      <div className=\"flex justify-between items-center mb-4\">\n        <h1 className=\"text-2xl font-semibold\">Bank Accounts</h1>\n        <ExportTransactionsButton selectedBankIds={Array.from(selectedRows)} />\n      </div>\n      <p className=\"mb-4 text-gray-400\">Select one or more banks from the list to include them in the export.</p>\n      <Grid\n        data={process(banks.map(item => ({...item, selected: selectedRows.has(item.id)})), dataState)}\n        pageable={true}\n        sortable={true}\n        {...dataState}\n        onDataStateChange={(e) => setDataState(e.dataState)}\n        style={{ height: '70vh' }}\n        selectable={{ enabled: true, mode: 'multiple', checkboxOnly: true }}\n        onSelectionChange={handleSelectionChange}\n        dataItemKey=\"id\"\n      >\n        <Column field=\"selected\" width=\"50px\" />\n        <Column field=\"name\" title=\"Bank Name\" />\n        <Column field=\"accountNumber\" title=\"Account Number\" />\n        <Column field=\"balance\" title=\"Current Balance\" format=\"{0:c}\" />\n        <Column field=\"currency\" title=\"Currency\" />\n      </Grid>\n    </div>\n  );\n};\n\nexport default BankList;\n"},"repairedBlock":false,"fileName":"BankList.jsx"},{"filePath":"src/modules/banks/BankDetails.jsx","fileContent":"import React from 'react';\nimport { useParams } from 'react-router-dom';\nimport { Card, Statistic, Row, Col } from 'antd';\nimport { Grid, GridColumn as Column } from '@progress/kendo-react-grid';\nimport ExportTransactionsButton from './components/ExportTransactionsButton';\n\n// Mock data for demonstration\nconst bankDetailsData = {\n  id: 'bank-123',\n  name: 'Arthapay Premier Checking',\n  accountNumber: '**** **** **** 1234',\n  balance: 150324.75,\n  currency: 'USD',\n};\n\nconst recentTransactionsData = [\n  { id: 'txn-1', date: '2023-10-26', description: 'Vendor Payment', amount: -1500, type: 'Debit' },\n  { id: 'txn-2', date: '2023-10-25', description: 'Client Deposit', amount: 5000, type: 'Credit' },\n  { id: 'txn-3', date: '2023-10-24', description: 'Software Subscription', amount: -99.99, type: 'Debit' },\n];\n\nconst BankDetails = () => {\n  const { bankId } = useParams(); // I