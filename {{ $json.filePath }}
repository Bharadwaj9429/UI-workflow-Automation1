[{"filePath":"src/modules/banks/httpServices.js","fileContent":"import { appClientMethods, deriveErrorMessage } from '~/core/http.service';\n\n/**\n * Initiates a transaction export job on the server.\n * @param {object} params - The export configuration (dateRange, format, transactionTypes, bankAccountIds).\n * @param {function} onSuccess - Callback for successful initiation, returns job data.\n * @param {function} onError - Callback for errors.\n */\nexport const requestTransactionExport = (params, onSuccess, onError) => {\n  appClientMethods.post('/banks/transactions/export', params)\n    .then(res => onSuccess(res.data))\n    .catch(err => onError(deriveErrorMessage(err)));\n};\n\n/**\n * Fetches the status of an ongoing export job.\n * @param {string} jobId - The ID of the export job.\n * @param {function} onSuccess - Callback for success, returns job status.\n * @param {function} onError - Callback for errors.\n */\nexport const getExportStatus = (jobId, onSuccess, onError) => {\n  appClientMethods.get(`/banks/transactions/export/status/${jobId}`)\n    .then(res => onSuccess(res.data))\n    .catch(err => onError(deriveErrorMessage(err)));\n};\n\n/**\n * Retrieves the history of all transaction exports for the user.\n * @param {object} params - Pagination and filtering parameters.\n * @param {function} onSuccess - Callback for success, returns list of exports.\n * @param {function} onError - Callback for errors.\n */\nexport const getExportHistory = (params, onSuccess, onError) => {\n  appClientMethods.get('/banks/transactions/export/history', { params })\n    .then(res => onSuccess(res.data))\n    .catch(err => onError(deriveErrorMessage(err)));\n};\n\n/**\n * Fetches available transaction types for filtering.\n * @param {function} onSuccess - Callback for success, returns list of transaction types.\n * @param {function} onError - Callback for errors.\n */\nexport const getTransactionTypes = (onSuccess, onError) => {\n  appClientMethods.get('/lookups/transaction-types')\n    .then(res => onSuccess(res.data))\n    .catch(err => onError(deriveErrorMessage(err)));\n};\n\n/**\n * Fetches user's bank accounts for filtering.\n * @param {function} onSuccess - Callback for success, returns list of bank accounts.\n * @param {function} onError - Callback for errors.\n */\nexport const getBankAccounts = (onSuccess, onError) => {\n    appClientMethods.get('/banks/accounts')\n      .then(res => onSuccess(res.data))\n      .catch(err => onError(deriveErrorMessage(err)));\n  };\n","action":"CREATE","type":"unknown","raw":{"filePath":"src/modules/banks/httpServices.js","action":"CREATE","content":"import { appClientMethods, deriveErrorMessage } from '~/core/http.service';\n\n/**\n * Initiates a transaction export job on the server.\n * @param {object} params - The export configuration (dateRange, format, transactionTypes, bankAccountIds).\n * @param {function} onSuccess - Callback for successful initiation, returns job data.\n * @param {function} onError - Callback for errors.\n */\nexport const requestTransactionExport = (params, onSuccess, onError) => {\n  appClientMethods.post('/banks/transactions/export', params)\n    .then(res => onSuccess(res.data))\n    .catch(err => onError(deriveErrorMessage(err)));\n};\n\n/**\n * Fetches the status of an ongoing export job.\n * @param {string} jobId - The ID of the export job.\n * @param {function} onSuccess - Callback for success, returns job status.\n * @param {function} onError - Callback for errors.\n */\nexport const getExportStatus = (jobId, onSuccess, onError) => {\n  appClientMethods.get(`/banks/transactions/export/status/${jobId}`)\n    .then(res => onSuccess(res.data))\n    .catch(err => onError(deriveErrorMessage(err)));\n};\n\n/**\n * Retrieves the history of all transaction exports for the user.\n * @param {object} params - Pagination and filtering parameters.\n * @param {function} onSuccess - Callback for success, returns list of exports.\n * @param {function} onError - Callback for errors.\n */\nexport const getExportHistory = (params, onSuccess, onError) => {\n  appClientMethods.get('/banks/transactions/export/history', { params })\n    .then(res => onSuccess(res.data))\n    .catch(err => onError(deriveErrorMessage(err)));\n};\n\n/**\n * Fetches available transaction types for filtering.\n * @param {function} onSuccess - Callback for success, returns list of transaction types.\n * @param {function} onError - Callback for errors.\n */\nexport const getTransactionTypes = (onSuccess, onError) => {\n  appClientMethods.get('/lookups/transaction-types')\n    .then(res => onSuccess(res.data))\n    .catch(err => onError(deriveErrorMessage(err)));\n};\n\n/**\n * Fetches user's bank accounts for filtering.\n * @param {function} onSuccess - Callback for success, returns list of bank accounts.\n * @param {function} onError - Callback for errors.\n */\nexport const getBankAccounts = (onSuccess, onError) => {\n    appClientMethods.get('/banks/accounts')\n      .then(res => onSuccess(res.data))\n      .catch(err => onError(deriveErrorMessage(err)));\n  };\n"},"repairedBlock":false,"fileName":"httpServices.js"},{"filePath":"src/modules/banks/components/TransactionExportModal.jsx","fileContent":"import React, { useState, useEffect, useCallback } from 'react';\nimport { Modal, Form, DatePicker, Select, Button, Spin, Progress, notification, Alert } from 'antd';\nimport { requestTransactionExport, getExportStatus, getTransactionTypes, getBankAccounts } from '../httpServices';\nimport dayjs from 'dayjs';\n\nconst { RangePicker } = DatePicker;\nconst { Option } = Select;\n\nconst EXPORT_FORMATS = ['CSV', 'PDF', 'Excel'];\nconst POLLING_INTERVAL = 3000; // 3 seconds\n\nconst TransactionExportModal = ({ visible, onClose, initialBankIds = [] }) => {\n  const [form] = Form.useForm();\n  const [loading, setLoading] = useState(false);\n  const [exportJob, setExportJob] = useState(null);\n  const [error, setError] = useState('');\n  const [transactionTypes, setTransactionTypes] = useState([]);\n  const [bankAccounts, setBankAccounts] = useState([]);\n\n  useEffect(() => {\n    if (visible) {\n      // Reset state when modal opens\n      setExportJob(null);\n      setError('');\n      form.resetFields();\n      form.setFieldsValue({ bankAccountIds: initialBankIds });\n\n      // Fetch data for form selects\n      getTransactionTypes(\n        (data) => setTransactionTypes(data || []),\n        (err) => console.error('Failed to fetch transaction types', err)\n      );\n      getBankAccounts(\n        (data) => setBankAccounts(data || []),\n        (err) => console.error('Failed to fetch bank accounts', err)\n      );\n    }\n  }, [visible, initialBankIds, form]);\n\n  const pollStatus = useCallback((jobId) => {\n    const interval = setInterval(() => {\n      getExportStatus(jobId, (statusData) => {\n        setExportJob(statusData);\n        if (statusData.status === 'COMPLETED' || statusData.status === 'FAILED') {\n          clearInterval(interval);\n          setLoading(false);\n          if (statusData.status === 'COMPLETED') {\n            notification.success({\n              message: 'Export Ready',\n              description: 'Your transaction export is ready for download.',\n            });\n          } else {\n            setError('Export failed. Please try again or contact support.');\n            notification.error({ message: 'Export Failed' });\n          }\n        }\n      }, (err) => {\n        setError(err);\n        setLoading(false);\n        clearInterval(interval);\n      });\n    }, POLLING_INTERVAL);\n    return () => clearInterval(interval);\n  }, []);\n\n  const handleFinish = (values) => {\n    setLoading(true);\n    setError('');\n    const params = {\n      ...values,\n      dateRange: {\n        from: values.dateRange[0].toISOString(),\n        to: values.dateRange[1].toISOString(),\n      },\n    };\n    requestTransactionExport(params, (jobData) => {\n      setExportJob(jobData);\n      if (jobData.jobId) {\n        pollStatus(jobData.jobId);\n      }\n    }, (err) => {\n      setError(err);\n      setLoading(false);\n      notification.error({ message: 'Error', description: err });\n    });\n  };\n\n  const handleDownload = () => {\n    if (exportJob?.downloadUrl) {\n      window.open(exportJob.downloadUrl, '_blank');\n      handleClose();\n    }\n  };\n\n  const handleClose = () => {\n    setExportJob(null);\n    setLoading(false);\n    onClose();\n  };\n\n  const renderContent = () => {\n    if (loading || exportJob?.status === 'PROCESSING') {\n      return (\n        <div className='flex flex-col items-center justify-center p-8'>\n          <Spin size='large' />\n          <p className='mt-4 text-lg text-[var(--textPrimary)]'>Export in Progress...</p>\n          <Progress percent={exportJob?.progress || 0} className='w-full mt-4' />\n          <p className='mt-2 text-sm text-[var(--textSecondary)]'>You will be notified when it's ready. You can close this window.</p>\n        </div>\n      );\n    }\n\n    if (exportJob?.status === 'COMPLETED') {\n      return (\n        <div className='flex flex-col items-center justify-center p-8'>\n          <h3 className='text-xl font-semibold text-[var(--textPrimary)]'>Export Complete!</h3>\n          <p className='my-4 text-center text-[var(--textSecondary)]'>Your transaction export file is ready.</p>\n          <Button type='primary' size='large' onClick={handleDownload}>\n            Download File\n          </Button>\n        </div>\n      );\n    }\n\n    return (\n      <Form form={form} layout='vertical' onFinish={handleFinish}>\n        {error && <Alert message={error} type='error' className='mb-4' />}\n        <Form.Item\n          name='dateRange'\n          label='Date Range'\n          rules={[{ required: true, message: 'Please select a date range' }]}\n        >\n          <RangePicker className='w-full' />\n        </Form.Item>\n        <Form.Item\n          name='format'\n          label='Export Format'\n          initialValue='CSV'\n          rules={[{ required: true, message: 'Please choose a format' }]}\n        >\n          <Select placeholder='Select a format'>\n            {EXPORT_FORMATS.map(format => <Option key={format} value={format}>{format}</Option>)}\n          </Select>\n        </Form.Item>\n        <Form.Item\n          name='transactionTypes'\n          label='Transaction Types (optional)'\n        >\n          <Select mode='multiple' allowClear placeholder='All transaction types'>\n            {transactionTypes.map(type => <Option key={type.id} value={type.id}>{type.name}</Option>)}\n          </Select>\n        </Form.Item>\n        <Form.Item\n          name='bankAccountIds'\n          label='Bank Accounts'\n          rules={[{ required: true, message: 'Please select at least one bank account' }]}\n        >\n          <Select mode='multiple' allowClear placeholder='Select bank accounts to include'>\n            {bankAccounts.map(acc => <Option key={acc.id} value={acc.id}>{acc.name} - {acc.accountNumber}</Option>)}\n          </Select>\n        </Form.Item>\n        <Form.Item className='text-right mb-0'>\n          <Button onClick={handleClose} className='mr-2'>Cancel</Button>\n          <Button type='primary' htmlType='submit' loading={loading}>Start Export</Button>\n        </Form.Item>\n      </Form>\n    );\n  };\n\n  return (\n    <Modal\n      title='Export Transactions'\n      open={visible}\n      onCancel={handleClose}\n      footer={null}\n      width={600}\n      destroyOnClose\n    >\n      {renderContent()}\n    </Modal>\n  );\n};\n\nexport default TransactionExportModal;\n","action":"CREATE","type":"unknown","raw":{"filePath":"src/modules/banks/components/TransactionExportModal.jsx","action":"CREATE","content":"import React, { useState, useEffect, useCallback } from 'react';\nimport { Modal, Form, DatePicker, Select, Button, Spin, Progress, notification, Alert } from 'antd';\nimport { requestTransactionExport, getExportStatus, get