[{"filePath":"src/modules/banks/ExportTransactionsButton.jsx","fileContent":"import React, { useState } from 'react';\nimport { Button } from 'antd';\nimport { DownloadOutlined } from '@ant-design/icons';\nimport TransactionExportModal from './TransactionExportModal';\n\n/**\n * A button to trigger the transaction export modal.\n * Can be used in list views (for multiple banks) or detail views (for a single bank).\n * @param {{ selectedBankIds?: string[], buttonType?: 'primary' | 'default' | 'dashed' | 'link' | 'text', buttonText?: string }}\n */\nconst ExportTransactionsButton = ({ selectedBankIds = [], buttonType = 'primary', buttonText = 'Export Transactions' }) => {\n  const [isModalVisible, setIsModalVisible] = useState(false);\n\n  const showModal = () => {\n    setIsModalVisible(true);\n  };\n\n  const handleClose = () => {\n    setIsModalVisible(false);\n  };\n\n  return (\n    <>\n      <Button\n        type={buttonType}\n        icon={<DownloadOutlined />}\n        onClick={showModal}\n        style={{ height: 'var(--buttonHeight)' }}\n      >\n        {buttonText}\n      </Button>\n      <TransactionExportModal\n        visible={isModalVisible}\n        onClose={handleClose}\n        initialSelectedBankIds={selectedBankIds}\n      />\n    </>\n  );\n};\n\nexport default ExportTransactionsButton;\n","action":"CREATE","type":"unknown","raw":{"filePath":"src/modules/banks/ExportTransactionsButton.jsx","action":"CREATE","content":"import React, { useState } from 'react';\nimport { Button } from 'antd';\nimport { DownloadOutlined } from '@ant-design/icons';\nimport TransactionExportModal from './TransactionExportModal';\n\n/**\n * A button to trigger the transaction export modal.\n * Can be used in list views (for multiple banks) or detail views (for a single bank).\n * @param {{ selectedBankIds?: string[], buttonType?: 'primary' | 'default' | 'dashed' | 'link' | 'text', buttonText?: string }}\n */\nconst ExportTransactionsButton = ({ selectedBankIds = [], buttonType = 'primary', buttonText = 'Export Transactions' }) => {\n  const [isModalVisible, setIsModalVisible] = useState(false);\n\n  const showModal = () => {\n    setIsModalVisible(true);\n  };\n\n  const handleClose = () => {\n    setIsModalVisible(false);\n  };\n\n  return (\n    <>\n      <Button\n        type={buttonType}\n        icon={<DownloadOutlined />}\n        onClick={showModal}\n        style={{ height: 'var(--buttonHeight)' }}\n      >\n        {buttonText}\n      </Button>\n      <TransactionExportModal\n        visible={isModalVisible}\n        onClose={handleClose}\n        initialSelectedBankIds={selectedBankIds}\n      />\n    </>\n  );\n};\n\nexport default ExportTransactionsButton;\n"},"repairedBlock":false,"fileName":"ExportTransactionsButton.jsx"},{"filePath":"src/modules/banks/TransactionExportModal.jsx","fileContent":"import React, { useState, useEffect } from 'react';\nimport { Modal, Form, DatePicker, Radio, Select, Button, message, Spin, Alert } from 'antd';\nimport { getBankAccountsForExport, getTransactionTypes, startTransactionExport } from './httpServices';\n\nconst { RangePicker } = DatePicker;\nconst { Option } = Select;\n\nconst TransactionExportModal = ({ visible, onClose, initialSelectedBankIds }) => {\n  const [form] = Form.useForm();\n  const [loading, setLoading] = useState(false);\n  const [error, setError] = useState(null);\n  const [bankAccounts, setBankAccounts] = useState([]);\n  const [transactionTypes, setTransactionTypes] = useState([]);\n\n  useEffect(() => {\n    if (visible) {\n      // Reset form and state on open\n      form.resetFields();\n      setError(null);\n      form.setFieldsValue({ bankAccountIds: initialSelectedBankIds });\n\n      // Fetch data for form selects\n      getBankAccountsForExport(null, (data) => setBankAccounts(data.accounts || []), () => message.error('Failed to load bank accounts.'));\n      getTransactionTypes(null, (data) => setTransactionTypes(data.types || []), () => message.error('Failed to load transaction types.'));\n    }\n  }, [visible, initialSelectedBankIds, form]);\n\n  const handleExport = (values) => {\n    setLoading(true);\n    setError(null);\n    const params = {\n      ...values,\n      fromDate: values.dateRange[0].toISOString(),\n      toDate: values.dateRange[1].toISOString(),\n    };\n    delete params.dateRange;\n\n    startTransactionExport(\n      params,\n      (res) => {\n        setLoading(false);\n        message.success(res.message || 'Export started! You will be notified via email when it is ready.');\n        onClose();\n      },\n      (err) => {\n        setLoading(false);\n        setError(err);\n      }\n    );\n  };\n\n  return (\n    <Modal\n      title=\"Export Transactions\"\n      visible={visible}\n      onCancel={onClose}\n      footer={null}\n      width={600}\n      destroyOnClose\n    >\n      <Spin spinning={loading} tip=\"Preparing your export...\">\n        <Form form={form} layout=\"vertical\" onFinish={handleExport}>\n          <Form.Item\n            name=\"bankAccountIds\"\n            label=\"Bank Accounts\"\n            rules={[{ required: true, message: 'Please select at least one bank account.' }]}\n          >\n            <Select mode=\"multiple\" placeholder=\"Select bank accounts\" allowClear>\n              {bankAccounts.map(acc => <Option key={acc.id} value={acc.id}>{acc.name} - {acc.accountNumber}</Option>)\n            </Select>\n          </Form.Item>\n\n          <Form.Item\n            name=\"dateRange\"\n            label=\"Date Range\"\n            rules={[{ required: true, message: 'Please select a date range.' }]}\n          >\n            <RangePicker className=\"w-full\" />\n          </Form.Item>\n\n          <Form.Item\n            name=\"transactionTypes\"\n            label=\"Transaction Types\"\n            rules={[{ required: true, message: 'Please select transaction types.' }]}\n          >\n            <Select mode=\"multiple\" placeholder=\"All transaction types\" allowClear>\n                {transactionTypes.map(type => <Option key={type.id} value={type.id}>{type.name}</Option>)\n            </Select>\n          </Form.Item>\n\n          <Form.Item\n            name=\"format\"\n            label=\"Export Format\"\n            initialValue=\"CSV\"\n            rules={[{ required: true, message: 'Please choose an export format.' }]}\n          >\n            <Radio.Group>\n              <Radio.Button value=\"CSV\">CSV</Radio.Button>\n              <Radio.Button value=\"Excel\">Excel</Radio.Button>\n              <Radio.Button value=\"PDF\">PDF</Radio.Button>\n            </Radio.Group>\n          </Form.Item>\n\n          {error && <Alert message={error} type=\"error\" showIcon className=\"mb-4\" />}\n\n          <div className=\"flex justify-end space-x-2\">\n            <Button onClick={onClose}>Cancel</Button>\n            <Button type=\"primary\" htmlType=\"submit\" loading={loading}>\n              Start Export\n            </Button>\n          </div>\n        </Form>\n      </Spin>\n    </Modal>\n  );\n};\n\nexport default TransactionExportModal;\n","action":"CREATE","type":"unknown","raw":{"filePath":"src/modules/banks/TransactionExportModal.jsx","action":"CREATE","content":"import React, { useState, useEffect } from 'react';\nimport { Modal, Form, DatePicker, Radio, Select, Button, message, Spin, Alert } from 'antd';\nimport { getBankAccountsForExport, getTransactionTypes, startTransactionExport } from './httpServices';\n\nconst { RangePicker } = DatePicker;\nconst { Option } = Select;\n\nconst TransactionExportModal = ({ visible, onClose, initialSelectedBankIds }) => {\n  const [form] = Form.useForm();\n  const [loading, setLoading] = useState(false);\n  const [error, setError] = useState(null);\n  const [bankAccounts, setBankAccounts] = useState([]);\n  const [transactionTypes, setTransactionTypes] = useState([]);\n\n  useEffect(() => {\n    if (visible) {\n      // Reset form and state on open\n      form.resetFields();\n      setError(null);\n      form.setFieldsValue({ bankAccountIds: initialSelectedBankIds });\n\n      // Fetch data for form selects\n      getBankAccountsForExport(null, (data) => setBankAccounts(data.accounts || []), () => message.error('Failed to load bank accounts.'));\n      getTransactionTypes(null, (data) => setTransactionTypes(data.types || []), () => message.error('Failed to load transaction types.'));\n    }\n  }, [visible, initialSelectedBankIds, form]);\n\n  const handleExport = (values) => {\n    setLoading(true);\n    setError(null);\n    const params = {\n      ...values,\n      fromDate: values.dateRange[0].toISOString(),\n      toDate: values.dateRange[1].toISOString(),\n    };\n    delete params.dateRange;\n\n    startTransactionExport(\n      params,\n      (res) => {\n        setLoading(false);\n        message.success(res.message || 'Export started! You will be notified via email when it is ready.');\n        onClose();\n      },\n      (err) => {\n        setLoading(false);\n        setError(err);\n      }\n    );\n  };\n\n  return (\n    <Modal\n      title=\"Export Transactions\"\n      visible={visible}\n      onCancel={onClose}\n      footer={null}\n      width={600}\n      destroyOnClose\n    >\n      <Spin spinning={loading} tip=\"Preparing your export...\">\n        <Form form={form} layout=\"vertical\" onFinish={handleExport}>\n          <Form.Item\n            name=\"bankAccountIds\"\n            label=\"Bank Accounts\"\n            rules={[{ required: true, message: 'Please select at least one bank account.' }]}\n          >\n            <Select mode=\"multiple\" placeholder=\"Select bank accounts\" allowClear>\n              {bankAccounts.map(acc => <Option key={acc.id} value={acc.id}>{acc.name} - {acc.accountNumber}</Option>)\n            </Select>\n          </Form.Item>\n\n          <Form.Item\n            name=\"dateRange\"\n            label=\"Date Range\"\n            rules={[{ required: true, message: 'Please select a date range.' }]}\n          >\n            <RangePicker className=\"w-full\" />\n          </Form.Item>\n\n          <Form.Item\n            name=\"transactionTypes\"\n            label=\"Transaction Types\"\n            rules={[{ required: true, message: 'Please select transaction types.' }]}\n          >\n            <Select mode=\"multiple\" placeholder=\"All transaction types\" allowClear>\n                {transactionTypes.map(type => <Option key={type.id} value={type.id}>{type.name}</Option>)\n            </Select>\n          </Form.Item>\n\n          <Form.Item\n            name=\"format\"\n            label=\"Export Format\"\n            initialValue=\"CSV\"\n            rules={[{ required: true, message: 'Please choose an export format.' }]}\n          >\n            <Radio.Group>\n              <Radio.Button value=\"CSV\">CSV</Radio.Button>\n              <Radio.Button value=\"Excel\">Excel</Radio.Button>\n              <Radio.Button value=\"PDF\">PDF</Radio.Button>\n            </Radio.Group>\n          </Form.Item>\n\n          {error && <Alert message={error} type=\"error\" showIcon className=\"mb-4\" />}\n\n          <div className=\"flex justify-end space-x-2\">\n            <Button onClick={onClose}>Cancel</Button>\n            <Button type=\"primary\" htmlType=\"submit\" loading={loading}>\n              Start Export\n            </Button>\n          </div>\n        </Form>\n      </Spin>\n    </Modal>\n  );\n};\n\nexport default TransactionExportModal;\n"},"repairedBlock":false,"fileName":"TransactionExportModal.jsx"},{"filePath":"src/modules/banks/ExportHistory.jsx","fileContent":"import React, { useState, useEffect, useCallback } from 'react';\nimport { Grid, GridColumn } from '@progress/kendo-react-grid';\nimport { process } from '@progress/kendo-data-query';\nimport { Button, message, Tag } from 'antd';\nimport { DownloadOutlined, SyncOutlined } from '@ant-design/icons';\nimport { getExportHistory, downloadExportedFile } from './httpServices';\n\nconst initialGridState = {\n  sort: [{ field: 'createdAt', dir: 'desc' }],\n  take: 10,\n  skip: 0,\n};\n\nconst ExportHistory = () => {\n  const [gridData, setGridData] = useState(null);\n  const [gridState, setGridState] = useState(initialGridState);\n  const [loading, setLoading] = useState(true);\n\n  const fetchHistory = useCallback(() => {\n    setLoading(true);\n    getExportHistory(\n      null,\n      (data) => {\n        setGridData({ data: data.exports, total: data.total });\n        setLoading(false);\n      },\n      (err) => {\n        message.error(err || 'Failed to fetch export history.');\n        setLoading(false);\n      }\n    );\n  }, []);\n\n  useEffect(() => {\n    fetchHistory();\n  }, [fetchHistory]);\n\n  const handleGridStateChange = (e) => {\n    setGridState(e.dataState);\n  };\n\n  const handleDownload = (fileId, fileName) => {\n    message.info(`Starting download for ${fileName}`);\n    downloadExportedFile(\n        { fileId }, \n        (blob) => {\n            const url = window.URL.createObjectURL(new Blob([blob]));\n            const link = document.createElement('a');\n            link.href = url;\n            link.setAttribute('download', fileName);\n            document.body.appendChild(link);\n            link.click();\n            link.parentNode.removeChild(link);\n        },\n        (err) => message.error(err || 'Download failed.')\n    );\n  };\n\n  const StatusCell = (props) => {\n    const status = props.dataItem.status;\n    let color = 'blue';\n    if (status === 'Completed') color = 'green';\n    if (status === 'Failed') color = 'red';\n    return <td><Tag color={color}>{status.toUpperCase()}</Tag></td>;\n  };\n\n  const ActionsCell = (props) => {\n    const { status, fileId, fileName } = props.dataItem;\n    return (\n        <td className=\"text-center\">\n            {status === 'Completed' && (\n                <Button \n                    type=\"primary\" \n                    icon={<DownloadOutlined />} \n                    onClick={() => handleDownload(fileId, fileName)}\n                >\n                    Download\n                </Button>\n            )}\n        </td>\n    );\n  }\n\n  return (\n    <div className=\"p-4 bg-[var(--bodyBg)]\">\n        <div className=\"flex justify-between items-center mb-4\">\n            <h1 className=\"text-2xl font-semibold text-[var(--textWhite)]\">Export History</h1>\n            <Button icon={<SyncOutlined />} onClick={fetchHistory} loading={loading}>Refresh</Button>\n        </div>\n      \n        <Grid\n            data={gridData ? process(gridData.data, gridState) : []}\n            total={gridData?.total}\n            sortable\n            pageable\n            filterable\n            {...gridState}\n            onDataStateChange={handleGridStateChange}\n            style={{ height: '70vh' }}\n            className=\"shadow-lg\"\n        >\n            <GridColumn field=\"createdAt\" title=\"Export Date\" filter=\"date\" format=\"{0:g}\" width=\"200px\" />\n            <GridColumn field=\"format\" title=\"Format\" width=\"100px\" />\n            <GridColumn field=\"dateRange\" title=\"Date Range\" />\n            <GridColumn field=\"status\" title=\"Status\" cell={StatusCell} width=\"120px\" />\n            <GridColumn title=\"Actions\" cell={ActionsCell} width=\"150px\" filterable={false} sortable={false} />\n        </Grid>\n    </div>\n  );\n};\n\nexport default ExportHistory;\n","action":"CREATE","type":"unknown","raw":{"filePath":"src/modules/banks/ExportHistory.jsx","action":"CREATE","content":"import React, { useState, useEffect, useCallback } from 'react';\nimport { Grid, GridColumn } from '@progress/kendo-react-grid';\nimport { process } from '@progress/kendo-data-query';\nimport { Button, message, Tag } from 'antd';\nimport { DownloadOutlined, SyncOutlined } from '@ant-design/icons';\nimport { getExportHistory, downloadExportedFile } from './httpServices';\n\nconst initialGridState = {\n  sort: [{ field: 'createdAt', dir: 'desc' }],\n  take: 10,\n  skip: 0,\n};\n\nconst ExportHistory = () => {\n  const [gridData, setGridData] = useState(null);\n  const [gridState, setGridState] = useState(initialGridState);\n  const [loading, setLoading] = useState(true);\n\n  const fetchHistory = useCallback(() => {\n    setLoading(true);\n    getExportHistory(\n      null,\n      (data) => {\n        setGridData({ data: data.exports, total: data.total });\n        setLoading(false);\n      },\n      (err) => {\n        message.error(err || 'Failed to fetch export history.');\n        setLoading(false);\n      }\n    );\n  }, []);\n\n  useEffect(() => {\n    fetchHistory();\n  }, [fetchHistory]);\n\n  const handleGridStateChange = (e) => {\n    setGridState(e.dataState);\n  };\n\n  const handleDownload = (fileId, fileName) => {\n    message.info(`Starting download for ${fileName}`);\n    downloadExportedFile(\n        { fileId }, \n        (blob) => {\n            const url = window.URL.createObjectURL(new Blob([blob]));\n            const link = document.createElement('a');\n            link.href = url;\n            link.setAttribute('download', fileName);\n            document.body.appendChild(link);\n            link.click();\n            link.parentNode.removeChild(link);\n        },\n        (err) => message.error(err || 'Download failed.')\n    );\n  };\n\n  const StatusCell = (props) => {\n    const status = props.dataItem.status;\n    let color = 'blue';\n    if (status === 'Completed') color = 'green';\n    if (status === 'Failed') color = 'red';\n    return <td><Tag color={color}>{status.toUpperCase()}</Tag></td>;\n  };\n\n  const ActionsCell = (props) => {\n    const { status, fileId, fileName } = props.dataItem;\n    return (\n        <td className=\"text-center\">\n            {status === 'Completed' && (\n                <Button \n                    type=\"primary\" \n                    icon={<DownloadOutlined />} \n                    onClick={() => handleDownload(fileId, fileName)}\n                >\n                    Download\n                </Button>\n            )}\n        </td>\n    );\n  }\n\n  return (\n    <div className=\"p-4 bg-[var(--bodyBg)]\">\n        <div className=\"flex justify-between items-center mb-4\">\n            <h1 className=\"text-2xl font-semibold text-[var(--textWhite)]\">Export History</h1>\n            <Button icon={<SyncOutlined />} onClick={fetchHistory} loading={loading}>Refresh</Button>\n        </div>\n      \n        <Grid\n            data={gridData ? process(gridData.data, gridState) : []}\n            total={gridData?.total}\n            sortable\n            pageable\n            filterable\n            {...gridState}\n            onDataStateChange={handleGridStateChange}\n            style={{ height: '70vh' }}\n            className=\"shadow-lg\"\n        >\n            <GridColumn field=\"createdAt\" title=\"Export Date\" filter=\"date\" format=\"{0:g}\" width=\"200px\" />\n            <GridColumn field=\"format\" title=\"Format\" width=\"100px\" />\n            <GridColumn field=\"dateRange\" title=\"Date Range\" />\n            <GridColumn field=\"status\" title=\"Status\" cell={StatusCell} width=\"120px\" />\n            <GridColumn title=\"Actions\" cell={ActionsCell} width=\"150px\" filterable={false} sortable={false} />\n        </Grid>\n    </div>\n  );\n};\n\nexport default ExportHistory;\n"},"repairedBlock":false,"fileName":"ExportHistory.jsx"},{"filePath":"src/modules/banks/TransactionSummaryChart.jsx","fileContent":"import React from 'react';\n\n/**\n * TransactionSummaryChart Component\n * This component is a placeholder for displaying transaction summary charts.\n * TODO: Integrate a charting library like Recharts or Chart.js.\n * It should fetch data based on the provided bankId and display relevant charts\n * (e.g., income vs. expense, spending by category).\n * @param {{ bankId: string }}\n */\nconst TransactionSummaryChart = ({ bankId }) => {\n  return (\n    <div className=\"p-6 bg-gray-800 rounded-lg shadow-md border border-gray-700\">\n      <h3 className=\"text-lg font-semibold text-[var(--textWhite)] mb-4\">Transaction Summary</h3>\n      <div className=\"flex items-center justify-center h-48 bg-gray-700 rounded-md\">\n        <p className=\"text-gray-400\">Chart will be displayed here for Bank ID: {bankId}</p>\n      </div>\n      <p className=\"text-xs text-gray-500 mt-2\">Note: Charting functionality is pending implementation.</p>\n    </div>\n  );\n};\n\nexport default TransactionSummaryChart;\n","action":"CREATE","type":"unknown","raw":{"filePath":"src/modules/banks/TransactionSummaryChart.jsx","action":"CREATE","content":"import React from 'react';\n\n/**\n * TransactionSummaryChart Component\n * This component is a placeholder for displaying transaction summary charts.\n * TODO: Integrate a charting library like Recharts or Chart.js.\n * It should fetch data based on the provided bankId and display relevant charts\n * (e.g., income vs. expense, spending by category).\n * @param {{ bankId: string }}\n */\nconst TransactionSummaryChart = ({ bankId }) => {\n  return (\n    <div className=\"p-6 bg-gray-800 rounded-lg shadow-md border border-gray-700\">\n      <h3 className=\"text-lg font-semibold text-[var(--textWhite)] mb-4\">Transaction Summary</h3>\n      <div className=\"flex items-center justify-center h-48 bg-gray-700 rounded-md\">\n        <p className=\"text-gray-400\">Chart will be displayed here for Bank ID: {bankId}</p>\n      </div>\n      <p className=\"text-xs text-gray-500 mt-2\">Note: Charting functionality is pending implementation.</p>\n    </div>\n  );\n};\n\nexport default TransactionSummaryChart;\n"},"repairedBlock":false,"fileName":"TransactionSummaryChart.jsx"},{"filePath":"src/modules/banks/httpServices.js","fileContent":"import { appClientMethods, deriveErrorMessage } from '~/core/http.service';\n\n// Fetches a list of bank accounts for the export modal select input\nexport const getBankAccountsForExport = (_, onSuccess, onError) => {\n  appClientMethods.get('/banks/list-for-export')\n    .then(res => onSuccess(res.data))\n    .catch(err => onError(deriveErrorMessage(err)));\n};\n\n// Fetches available transaction types for filtering\nexport const getTransactionTypes = (_, onSuccess, onError) => {\n  appClientMethods.get('/transactions/types')\n    .then(res => onSuccess(res.data))\n    .catch(err => onError(deriveErrorMessage(err)));\n};\n\n// Initiates a new transaction export job on the server\nexport const startTransactionExport = (params, onSuccess, onError) => {\n  appClientMethods.post('/transactions/export/start', params)\n    .then(res => onSuccess(res.data))\n    .catch(err => onError(deriveErrorMessage(err)));\n};\n\n// Retrieves the history of all past exports for the current user\nexport const getExportHistory = (_, onSuccess, onError) => {\n  appClientMethods.get('/transactions/export/history')\n    .then(res => onSuccess(res.data))\n    .catch(err => onError(deriveErrorMessage(err)));\n};\n\n// Downloads the specified exported file\nexport const downloadExportedFile = (params, onSuccess, onError) => {\n  appClientMethods.get(`/transactions/export/download/${params.fileId}`, { responseType: 'blob' })\n    .then(res => onSuccess(res.data))\n    .catch(err => onError(deriveErrorMessage(err)));\n};\n","action":"CREATE","type":"unknown","raw":{"filePath":"src/modules/banks/httpServices.js","action":"CREATE","content":"import { appClientMethods, deriveErrorMessage } from '~/core/http.service';\n\n// Fetches a list of bank accounts for the export modal select input\nexport const getBankAccountsForExport = (_, onSuccess, onError) => {\n  appClientMethods.get('/banks/list-for-export')\n    .then(res => onSuccess(res.data))\n    .catch(err => onError(deriveErrorMessage(err)));\n};\n\n// Fetches available transaction types for filtering\nexport const getTransactionTypes = (_, onSuccess, onError) => {\n  appClientMethods.get('/transactions/types')\n 