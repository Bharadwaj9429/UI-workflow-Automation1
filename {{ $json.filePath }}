[{"filePath":"src/modules/banks/httpServices.js","fileContent":"import { appClientMethods, deriveErrorMessage } from '~/core/http.service';\n\n/**\n * Initiates a new transaction export process.\n * @param {object} params - The export configuration (dateRange, format, types, bankAccountIds).\n * @param {function} onSuccess - Callback for successful request.\n * @param {function} onError - Callback for failed request.\n */\nexport const startTransactionExport = (params, onSuccess, onError) => {\n  appClientMethods.post('/banks/transactions/export', params)\n    .then(res => onSuccess(res.data))\n    .catch(err => onError(deriveErrorMessage(err)));\n};\n\n/**\n * Fetches the history of previously generated exports.\n * @param {function} onSuccess - Callback for successful request.\n * @param {function} onError - Callback for failed request.\n */\nexport const getExportHistory = (onSuccess, onError) => {\n  appClientMethods.get('/banks/transactions/export-history')\n    .then(res => onSuccess(res.data))\n    .catch(err => onError(deriveErrorMessage(err)));\n};\n\n/**\n * Fetches available bank accounts for the export modal selector.\n * @param {function} onSuccess - Callback for successful request.\n * @param {function} onError - Callback for failed request.\n */\nexport const getBankAccountsForExport = (onSuccess, onError) => {\n  appClientMethods.get('/banks/accounts')\n    .then(res => onSuccess(res.data))\n    .catch(err => onError(deriveErrorMessage(err)));\n};\n\n/**\n * Fetches available transaction types for the export modal filter.\n * @param {function} onSuccess - Callback for successful request.\n * @param {function} onError - Callback for failed request.\n */\nexport const getTransactionTypes = (onSuccess, onError) => {\n  appClientMethods.get('/transactions/types')\n    .then(res => onSuccess(res.data))\n    .catch(err => onError(deriveErrorMessage(err)));\n};\n","action":"CREATE","type":"unknown","raw":{"filePath":"src/modules/banks/httpServices.js","acti