         Download File\n          </Button>\n        </div>\n      );\n    }\n\n    return (\n      <Form form={form} layout='vertical' onFinish={handleFinish}>\n        {error && <Alert message={error} type='error' className='mb-4' />}\n        <Form.Item\n          name='dateRange'\n          label='Date Range'\n          rules={[{ required: true, message: 'Please select a date range' }]}\n        >\n          <RangePicker className='w-full' />\n        </Form.Item>\n        <Form.Item\n          name='format'\n          label='Export Format'\n          initialValue='CSV'\n          rules={[{ required: true, message: 'Please choose a format' }]}\n        >\n          <Select placeholder='Select a format'>\n            {EXPORT_FORMATS.map(format => <Option key={format} value={format}>{format}</Option>)}\n          </Select>\n        </Form.Item>\n        <Form.Item\n          name='transactionTypes'\n          label='Transaction Types (optional)'\n        >\n          <Select mode='multiple' allowClear placeholder='All transaction types'>\n            {transactionTypes.map(type => <Option key={type.id} value={type.id}>{type.name}</Option>)}\n          </Select>\n        </Form.Item>\n        <Form.Item\n          name='bankAccountIds'\n          label='Bank Accounts'\n          rules={[{ required: true, message: 'Please select at least one bank account' }]}\n        >\n          <Select mode='multiple' allowClear placeholder='Select bank accounts to include'>\n            {bankAccounts.map(acc => <Option key={acc.id} value={acc.id}>{acc.name} - {acc.accountNumber}</Option>)}\n          </Select>\n        </Form.Item>\n        <Form.Item className='text-right mb-0'>\n          <Button onClick={handleClose} className='mr-2'>Cancel</Button>\n          <Button type='primary' htmlType='submit' loading={loading}>Start Export</Button>\n        </Form.Item>\n      </Form>\n    );\n  };\n\n  return (\n    <Modal\n      title='Export Transactions'\n      open={visible}\n      onCancel={handleClose}\n      footer={null}\n      width={600}\n      destroyOnClose\n    >\n      {renderContent()}\n    </Modal>\n  );\n};\n\nexport default TransactionExportModal;\n"},"repairedBlock":false,"fileName":"TransactionExportModal.jsx"},{"filePath":"src/modules/banks/components/ExportTransactionsButton.jsx","fileContent":"import React, { useState } from 'react';\nimport { Button } from 'antd';\nimport { DownloadOutlined } from '@ant-design/icons';\nimport TransactionExportModal from './TransactionExportModal';\n\nconst ExportTransactionsButton = ({ selectedBankIds = [] }) => {\n  const [isModalVisible, setIsModalVisible] = useState(false);\n\n  const showModal = () => {\n    setIsModalVisible(true);\n  };\n\n  const handleClose = () => {\n    setIsModalVisible(false);\n  };\n\n  return (\n    <>\n      <Button\n        type='primary'\n        icon={<DownloadOutlined />}\n        onClick={showModal}\n      >\n        Export Transactions\n      </Button>\n      <TransactionExportModal\n        visible={isModalVisible}\n        onClose={handleClose}\n        initialBankIds={selectedBankIds}\n      />\n    </>\n  );\n};\n\nexport default ExportTransactionsButton;\n","action":"CREATE","type":"unknown","raw":{"filePath":"src/modules/banks/components/ExportTransactionsButton.jsx","action":"CREATE","content":"import React, { useState } from 'react';\nimport { Button } from 'antd';\nimport { DownloadOutlined } from '@ant-design/icons';\nimport TransactionExportModal from './TransactionExportModal';\n\nconst ExportTransactionsButton = ({ selectedBankIds = [] }) => {\n  const [isModalVisible, setIsModalVisible] = useState(false);\n\n  const showModal = () => {\n    setIsModalVisible(true);\n  };\n\n  const handleClose = () => {\n    setIsModalVisible(false);\n  };\n\n  return (\n    <>\n      <Button\n        type='primary'\n        icon={<DownloadOutlined />}\n        onClick={showModal}\n      >\n        Export Transactions\n      </Button>\n      <TransactionExportModal\n        visible={isModalVisible}\n        onClose={handleClose}\n        initialBankIds={selectedBankIds}\n      />\n    </>\n  );\n};\n\nexport default ExportTransactionsButton;\n"},"repairedBlock":false,"fileName":"ExportTransactionsButton.jsx"},{"filePath":"src/modules/banks/screens/ExportHistory.jsx","fileContent":"import React, { useState, useEffect } from 'react';\nimport { Grid, GridColumn as Column } from '@progress/kendo-react-grid';\nimport { process } from '@progress/kendo-data-query';\nimport { Button, notification } from 'antd';\nimport { DownloadOutlined } from '@ant-design/icons';\nimport { getExportHistory } from '../httpServices';\n\nconst DownloadCell = (props) => {\n  const { dataItem } = props;\n  return (\n    <td>\n      {dataItem.status === 'COMPLETED' ? (\n        <Button\n          type='link'\n          icon={<DownloadOutlined />}\n          onClick={() => window.open(dataItem.downloadUrl, '_blank')}\n        >\n          Download\n        </Button>\n      ) : (\n        <span className='capitalize text-[var(--textSecondary)]'>{dataItem.status.toLowerCase()}</span>\n      )}\n    </td>\n  );\n};\n\nconst ExportHistory = () => {\n  const [exports, setExports] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [dataState, setDataState] = useState({\n    skip: 0,\n    take: 10,\n    sort: [],\n    group: []\n  });\n\n  useEffect(() => {\n    setLoading(true);\n    getExportHistory({}, \n      (data) => {\n        setExports(data.items || []);\n        setLoading(false);\n      }, \n      (error) => {\n        notification.error({ message: 'Failed to fetch export history', description: error });\n        setLoading(false);\n      }\n    );\n  }, []);\n\n  const handleDataStateChange = (e) => {\n    setDataState(e.dataState);\n  };\n\n  const processedData = process(exports, dataState);\n\n  return (\n    <div className='p-6 bg-[var(--bodyBg)] text-[var(--textPrimary)]'>\n      <h1 className='text-2xl font-bold mb-6'>Transaction Export History</h1>\n      {loading ? (\n        <p>Loading history...</p>\n      ) : (\n        <Grid\n          style={{ height: '600px' }}\n          data={processedData}\n          {...dataState}\n          onDataStateChange={handleDataStateChange}\n          sortable\n          pageable\n          filterable\n          groupable\n        >\n          <Column field='createdAt' title='Date' filter='date' format='{0:yyyy-MM-dd HH:mm}' width='200px' />\n          <Column field='format' title='Format' width='100px' />\n          <Column field='parameters.dateRange.from' title='From Date' filter='date' format='{0:yyyy-MM-dd}' />\n          <Column field='parameters.dateRange.to' title='To Date' filter='date' format='{0:yyyy-MM-dd}' />\n          <Column field='status' title='Status' width='120px' />\n          <Column title='Download' cell={DownloadCell} filterable={false} sortable={false} width='150px' />\n        </Grid>\n      )}\n    </div>\n  );\n};\n\nexport default ExportHistory;\n","action":"CREATE","type":"unknown","raw":{"filePath":"src/modules/banks/screens/ExportHistory.jsx","action":"CREATE","content":"import React, { useState, useEffect } from 'react';\nimport { Grid, GridColumn as Column } from '@progress/kendo-react-grid';\nimport { process } from '@progress/kendo-data-query';\nimport { Button, notification } from 'antd';\nimport { DownloadOutlined } from '@ant-design/icons';\nimport { getExportHistory } from '../httpServices';\n\nconst DownloadCell = (props) => {\n  const { dataItem } = props;\n  return (\n    <td>\n      {dataItem.status === 'COMPLETED' ? (\n        <Button\n          type='link'\n          icon={<DownloadOutlined />}\n          onClick={() => window.open(dataItem.downloadUrl, '_blank')}\n        >\n          Download\n        </Button>\n      ) : (\n        <span className='capitalize text-[var(--textSecondary)]'>{dataItem.status.toLowerCase()}</span>\n      )}\n    </td>\n  );\n};\n\nconst ExportHistory = () => {\n  const [exports, setExports] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [dataState, setDataState] = useState({\n    skip: 0,\n    take: 10,\n    sort: [],\n    group: []\n  });\n\n  useEffect(() => {\n    setLoading(true);\n    getExportHistory({}, \n      (data) => {\n        setExports(data.items || []);\n        setLoading(false);\n      }, \n      (error) => {\n        notification.error({ message: 'Failed to fetch export history', description: error });\n        setLoading(false);\n      }\n    );\n  }, []);\n\n  const handleDataStateChange = (e) => {\n    setDataState(e.dataState);\n  };\n\n  const processedData = process(exports, dataState);\n\n  return (\n    <div className='p-6 bg-[var(--bodyBg)] text-[var(--textPrimary)]'>\n      <h1 className='text-2xl font-bold mb-6'>Transaction Export History</h1>\n      {loading ? (\n        <p>Loading history...</p>\n      ) : (\n        <Grid\n          style={{ height: '600px' }}\n          data={processedData}\n          {...dataState}\n          onDataStateChange={handleDataStateChange}\n          sortable\n          pageable\n          filterable\n          groupable\n        >\n          <Column field='createdAt' title='Date' filter='date' format='{0:yyyy-MM-dd HH:mm}' width='200px' />\n          <Column field='format' title='Format' width='100px' />\n          <Column field='parameters.dateRange.from' title='From Date' filter='date' format='{0:yyyy-MM-dd}' />\n          <Column field='parameters.dateRange.to' title='To Date' filter='date' format='{0:yyyy-MM-dd}' />\n          <Column field='status' title='Status' width='120px' />\n          <Column title='Download' cell={DownloadCell} filterable={false} sortable={false} width='150px' />\n        </Grid>\n      )}\n    </div>\n  );\n};\n\nexport default ExportHistory;\n"},"repairedBlock":false,"fileName":"ExportHistory.jsx"},{"filePath":"src/modules/banks/routesConfig.jsx","fileContent":"import React from 'react';\nimport Expo