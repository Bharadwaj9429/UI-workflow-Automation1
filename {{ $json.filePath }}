React, { useState, useEffect } from 'react';\nimport { Modal, Form, DatePicker, Select, Button, Spin, notification } from 'antd';\nimport { startTransactionExport, getBankAccountsForExport, getTransactionTypes } from './httpServices';\n\nconst { RangePicker } = DatePicker;\nconst { Option } = Select;\n\nconst TransactionExportModal = ({ visible, onCancel, selectedBankIds = [] }) => {\n  const [form] = Form.useForm();\n  const [loading, setLoading] = useState(false);\n  const [bankAccounts, setBankAccounts] = useState([]);\n  const [transactionTypes, setTransactionTypes] = useState([]);\n\n  useEffect(() => {\n    if (visible) {\n      // Fetch data for form selects when modal becomes visible\n      getBankAccountsForExport(\n        (data) => setBankAccounts(data.accounts || []),\n        (err) => notification.error({ message: 'Error fetching bank accounts', description: err })\n      );\n      getTransactionTypes(\n        (data) => setTransactionTypes(data.types || []),\n        (err) => notification.error({ message: 'Error fetching transaction types', description: err })\n      );\n    }\n  }, [visible]);\n\n  useEffect(() => {\n    // Pre-fill bank accounts if any are selected from the list view\n    if (selectedBankIds.length > 0) {\n      form.setFieldsValue({ bankAccountIds: selectedBankIds });\n    }\n  }, [selectedBankIds, form]);\n\n  const handleExport = (values) => {\n    setLoading(true);\n    const params = {\n      fromDate: values.dateRange[0].toISOString(),\n      toDate: values.dateRange[1].toISOString(),\n      format: values.format,\n      transactionTypeIds: values.transactionTypeIds,\n      bankAccountIds: values.bankAccountIds,\n    };\n\n    startTransactionExport(\n      params,\n      (data) => {\n        setLoading(false);\n        notification.success({\n          message: 'Export Started',\n          description: 'Your transaction export is being processed. You will receive an email notification when it is ready.',\n        });\n        onCancel();\n        form.resetFields();\n      },\n      (err) => {\n        setLoading(false);\n        notification.error({ message: 'Export Failed', description: err });\n      }\n    );\n  };\n\n  return (\n    <Modal\n      title=\"Export Transactions\"\n      open={visible}\n      onCancel={onCancel}\n      footer={null}\n      width={600}\n      className=\"bg-[var(--background)]\"\n    >\n      <Spin spinning={loading} tip=\"Processing export...\">\n        <Form form={form} layout=\"vertical\" onFinish={handleExport} className=\"p-4\">\n          <Form.Item name=\"dateRange\" label=\"Select Date Range\" rules={[{ required: true, message: 'Please select a date range!' }]}>\n            <RangePicker className=\"w-full\" />\n          </Form.Item>\n\n          <Form.Item name=\"format\" label=\"Choose Export Format\" initialValue=\"CSV\" rules={[{ required: true, message: 'Please select a format!' }]}>\n            <Select placeholder=\"Select a format\">\n              <Option value=\"CSV\">CSV</Option>\n              <Option value=\"PDF\">PDF</Option>\n              <Option value=\"EXCEL\">Excel (XLSX)</Option>\n            </Select>\n          </Form.Item>\n\n          <Form.Item name=\"bankAccountIds\" label=\"Bank Accounts to Include\" rules={[{ required: true, message: 'Please select at least one bank account!' }]}>\n            <Select mode=\"multiple\" allowClear placeholder=\"Select bank accounts\">\n              {bankAccounts.map(account => (\n                <Option key={account.id} value={account.id}>{account.name} - {account.accountNumber}</Option>\n              ))}\n            </Select>\n          </Form.Item>\n\n          <Form.Item name=\"transactionTypeIds\" label=\"Transaction Types to Include\">\n            <Select mode=\"multiple\" allowClear placeholder=\"All transaction types\">\n              {transactionTypes.map(type => (\n                <Option key={type.id} value={type.id}>{type.name}</Option>\n              ))}\n            </Select>\n          </Form.Item>\n\n          <div className=\"flex justify-end space-x-2 pt-4\">\n            <Button onClick={onCancel}>Cancel</Button>\n            <Button type=\"primary\" htmlType=\"submit\" style={{ backgroundColor: 'var(--primaryColor)', borderColor: 'var(--primaryColor)' }}>\n              Start Export\n            </Button>\n          </div>\n        </Form>\n      </Spin>\n    </Modal>\n  );\n};\n\nexport default TransactionExportModal;\n","action":"CREATE","type":"unknown","raw":{"filePath":"src/modules/banks/TransactionExportModal.jsx","action":"CREATE","content":"import React, { useState, useEffect } from 'react';\nimport { Modal, Form, DatePicker, Select, Button, Spin, notification } from 'antd';\nimport { startTransactionExport, getBankAccountsForExport, getTransactionTypes } from './httpServices';\n\nconst { RangePicker } = DatePicker;\nconst { Option } = Select;\n\nconst TransactionExportModal = ({ visible, onCancel, selectedBankIds = [] }) => {\n  const [form] = Form.useForm();\n  const [loading, setLoading] = useState(false);\n  const [bankAccounts, setBankAccounts] = useState([]);\n  const [transactionTypes, setTransactionTypes] = useState([]);\n\n  useEffect(() => {\n    if (visible) {\n      // Fetch data for form selects when modal becomes visible\n      getBankAccountsForExport(\n        (data) => setBankAccounts(data.accounts || []),\n        (err) => notification.error({ message: 'Error fetching bank accounts', description: err })\n      );\n      getTransactionTypes(\n        (data) => setTransactionTypes(data.types || []),\n        (err) => notification.error({ message: 'Error fetching transaction types', description: err })\n      );\n    }\n  }, [visible]);\n\n  useEffect(() => {\n    // Pre-fill bank accounts if any are selected from the list view\n    if (selectedBankIds.length > 0) {\n      form.setFieldsValue({ bankAccountIds: selectedBankIds });\n    }\n  }, [selectedBankIds, form]);\n\n  const handleExport = (values) => {\n    setLoading(true);\n    const params = {\n      fromDate: values.dateRange[0].toISOString(),\n      toDate: values.dateRange[1].toISOString(),\n      format: values.format,\n      transactionTypeIds: values.transactionTypeIds,\n      bankAccountIds: values.bankAccountIds,\n    };\n\n    startTransactionExport(\n      params,\n      (data) => {\n        setLoading(false);\n        notification.success({\n          message: 'Export Started',\n          description: 'Your transaction export is being processed. You will receive an email notification when it is ready.',\n        });\n        onCancel();\n        form.resetFields();\n      },\n      (err) => {\n        setLoading(false);\n        notification.error({ message: 'Export Failed', description: err });\n      }\n    );\n  };\n\n  return (\n    <Modal\n      title=\"Export Transactions\"\n      open={visible}\n      onCancel={onCancel}\n      footer={null}\n      width={600}\n      className=\"bg-[var(--background)]\"\n    >\n      <Spin spinning={loading} tip=\"Processing export...\">\n        <Form form={form} layout=\"vertical\" onFinish={handleExport} className=\"p-4\">\n          <Form.Item name=\"dateRange\" label=\"Select Date Range\" rules={[{ required: true, message: 'Please select a date range!' }]}>\n            <RangePicker className=\"w-full\" />\n          </Form.Item>\n\n          <Form.Item name=\"format\" label=\"Choose Export Format\" initialValue=\"CSV\" rules={[{ required: true, message: 'Please select a format!' }]}>\n            <Select placeholder=\"Select a format\">\n              <Option value=\"CSV\">CSV</Option>\n              <Option value=\"PDF\">PDF</Option>\n              <Option value=\"EXCEL\">Excel (XLSX)</Option>\n            </Select>\n          </Form.Item>\n\n          <Form.Item name=\"bankAccountIds\" label=\"Bank Accounts to Include\" rules={[{ required: true, message: 'Please select at least one bank account!' }]}>\n            <Select mode=\"multiple\" allowClear placeholder=\"Select bank accounts\">\n              {bankAccounts.map(account => (\n                <Option key={account.id} value={account.id}>{account.name} - {account.accountNumber}</Option>\n              ))}\n            </Select>\n          </Form.Item>\n\n          <Form.Item name=\"transactionTypeIds\" label=\"Transaction Types to Include\">\n            <Select mode=\"multiple\" allowClear placeholder=\"All transaction types\">\n              {transactionTypes.map(type => (\n                <Option key={type.id} value={type.id}>{type.name}</Option>\n              ))}\n            </Select>\n          </Form.Item>\n\n          <div className=\"flex justify-end space-x-2 pt-4\">\n            <Button onClick={onCancel}>Cancel</Button>\n            <Button type=\"primary\" htmlType=\"submit\" style={{ backgroundColor: 'var(--primaryColor)', borderColor: 'var(--primaryColor)' }}>\n              Start Export\n            </Button>\n          </div>\n        </Form>\n      </Spin>\n    </Modal>\n  );\n};\n\nexport default TransactionExportModal;\n"},"repairedBlock":false,"fileName":"TransactionExportModal.jsx"},{"filePath":"src/modules/banks/ExportHistory.jsx","fileContent":"import React, { useState, useEffect } from 'react';\nimport { Grid, GridColumn } from '@progress/kendo-react-grid';\nimport { process } from '@progress/kendo-data-query';\nimport { Button, notification, Tag, Spin } from 'antd';\nimport { DownloadOutlined, SyncOutlined, CheckCircleOutlined, CloseCircleOutlined } from '@ant-design/icons';\nimport { getExportHistory } from './httpServices';\n\nconst StatusCell = (props) => {\n  const { status } = props.dataItem;\n  let color, icon, text;\n  switch (status.toUpperCase()) {\n    case 'COMPLETED':\n      color = 'green';\n      icon = <CheckCircleOutlined />;\n      text = 'Completed';\n      break;\n    case 'PROCESSING':\n      color = 'blue';\n      icon = <SyncOutlined spin />;\n      text = 'Processing';\n      break;\n    case 'FAILED':\n      color = 'red';\n      icon = <CloseCircleOutlined />;\n      text = 'Failed';\n      break;\n    default:\n      color = 'gold';\n      text = 'Pending';\n  }\n  return <td><Tag icon={icon} color={color}>{text}</Tag></td>;\n};\n\nconst ActionCell = (props) => {\n  const { status, downloadUrl } = props.dataItem;\n  return (\n    <td>\n      {status.toUpperCase() === 'COMPLETED' && downloadUrl && (\n        <a href={downloadUrl} target=\"_blank\" rel=\"noopener noreferrer\" download>\n          <Button icon={<DownloadOutlined />} type=\"primary\" size=\"small\">\n            Download\n          </Button>\n        </a>\n      )}\n    </td>\n  );\n};\n\nconst ExportHistory = () => {\n  const [exports, setExports] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [dataState, setDataState] = useState({ skip: 0, take: 10 });\n\n  const fetchHistory = () => {\n    setLoading(true);\n    getExportHistory(\n      (data) => {\n        setExports(data.history || []);\n        setLoading(false);\n      },\n      (err) => {\n        notification.error({ message: 'Failed to load export history', description: err });\n        setLoading(false);\n      }\n    );\n  };\n\n  useEffect(() => {\n    fetchHistory();\n  }, []);\n\n  const onDataStateChange = (event) => {\n    setDataState(event.dataState);\n  };\n\n  return (\n    <div className=\"p-6 bg-[var(--bodyBg)] text-[var(--textWhite)]\">\n      <div className=\"flex justify-between items-center mb-4\">\n        <h1 className=\"text-2xl font-semibold\">Transaction Export History</h1>\n        <Button onClick={fetchHistory} icon={<SyncOutlined />} loading={loading}>Refresh</Button>\n      </div>\n      <Spin spinning={loading} size=\"large\">\n        <Grid\n          data={process(exports, dataState)}\n          {...dataState}\n          onDataStateChange={onDataStateChange}\n          pageable\n          sortable\n          filterable\n          style={{ height: '70vh' }}\n        >\n          <GridColumn field=\"createdAt\" title=\"Export Date\" filter=\"date\" format=\"{0:g}\" width=\"200px\" />\n          <GridColumn field=\"format\" title=\"Format\" width=\"100px\" />\n          <GridColumn field=\"parameters.dateRange\" title=\"Date Range\" />\n          <GridColumn field=\"status\" title=\"Status\" cell={StatusCell} width=\"150px\" />\n          <GridColumn title=\"Actions\" cell={ActionCell} width=\"150px\" filterable={false} sortable={false} />\n        </Grid>\n      </Spin>\n    </div>\n  );\n};\n\nexport default ExportHistory;\n","action":"CREATE","type":"unknown","raw":{"filePath":"src/modules/banks/ExportHistory.jsx","action":"CREATE","content":"import React, { useState, useEffect } from 'react';\nimport { Grid, GridColumn } from '@progress/kendo-react-grid';\nimport { process } from '@progress/kendo-data-query';\nimport { Button, notification, Tag, Spin } from 'antd';\nimport { DownloadOutlined, SyncOutlined, CheckCircleOutlined, CloseCircleOutlined } from '@ant-design/icons';\nimport { getExportHistory } from './httpServices';\n\nconst StatusCell = (props) => {\n  const { status } = props.dataItem;\n  let color, icon, text;\n  switch (status.toUpperCase()) {\n    case 'COMPLETED':\n      color = 'green';\n      icon = <CheckCircleOutlined />;\n      text = 'Completed';\n      break;\n    case 'PROCESSING':\n      color = 'blue';\n      icon = <SyncOutlined spin />;\n      text = 'Processing';\n      break;\n    case 'FAILED':\n      color = 'red';\n      icon = <CloseCircleOutlined />;\n      text = 'Failed';\n      break;\n    default:\n      color = 'gold';\n      text = 'Pending';\n  }\n  return <td><Tag icon={icon} color={color}>{text}</Tag></td>;\n};\n\nconst ActionCell = (props) => {\n  const { status, downloadUrl } = props.dataItem;\n  return (\n    <td>\n      {status.toUpperCase() === 'COMPLETED' && downloadUrl && (\n        <a href={downloadUrl} target=\"_blank\" rel=\"noopener noreferrer\" download>\n          <Button icon={<DownloadOutlined />} type=\"primary\" size=\"small\">\n            Download\n          </Button>\n        </a>\n      )}\n    </td>\n  );\n};\n\nconst ExportHistory = () => {\n  const [exports, setExports] = useState([]);\n  const [loading, setLoading] = useState(true);\n  const [dataState, setDataState] = useState({ skip: 0, take: 10 });\n\n  const fetchHistory = () => {\n    setLoading(true);\n    getExportHistory(\n      (data) => {\n        setExports(data.history || []);\n        setLoading(false);\n      },\n      (err) => {\n        notification.error({ message: 'Failed to load export history', description: err });\n        setLoading(false);\n      }\n    );\n  };\n\n  useEffect(() => {\n    fetchHistory();\n  }, []);\n\n  const onDataStateChange = (event) => {\n    setDataState(event.dataState);\n  };\n\n  return (\n    <div className=\"p-6 bg-[var(--bodyBg)] text-[var(--textWhite)]\">\n      <div className=\"flex justify-between items-center mb-4\">\n        <h1 className=\"text-2xl font-semibold\">Transaction Export History</h1>\n        <Button onClick={fetchHistory} icon={<SyncOutlined />} loading={loading}>Refresh</Button>\n      </div>\n      <Spin spinning={loading} size=\"large\">\n        <Grid\n          data={process(exports, dataState)}\n          {...dataState}\n          onDataStateChange={onDataStateChange}\n          pageable\n          sortable\n          filterable\n          style={{ height: '70vh' }}\n        >\n          <GridColumn field=\"createdAt\" title=\"Export Date\" filter=\"date\" format=\"{0:g}\" width=\"200px\" />\n          <GridColumn field=\"format\" title=\"Format\" width=\"100px\" />\n          <GridColumn field=\"parameters.dateRange\" title=\"Date Range\" />\n          <GridColumn field=\"status\" title=\"Status\" cell={StatusCell} width=\"150px\" />\n          <GridColumn title=\"Actions\" cell={ActionCell} width=\"150px\" filterable={false} sortable={false} />\n        </Grid>\n      </Spin>\n    </div>\n  );\n};\n\nexport default ExportHistory;\n"},"repairedBlock":false,"fileName":"ExportHistory.jsx"},{"filePath":"src/modules/banks/routesConfig.jsx","fileContent":"import React from 'react';\nimport ExportHistory from './ExportHistory';\n// Assuming other bank components are imported here\n// import BankList from './BankList';\n// import BankDetails from './BankDetails';\n\nconst BanksRoutesConfig = [\n  // {\n  //   path: '/banks',\n  //   element: <BankList />\n  // },\n  // {\n  //   path: '/banks/:bankId',\n  //   element: <BankDetails />\n  // },\n  {\n    path: '/banks/export-history',\n    element: <ExportHistory />\n  }\n];\n\nexport default BanksRoutesConfig;\n","action":"CREATE","type":"unknown","raw":{"filePath":"src/modules/banks/routesConfig.jsx","action":"CREATE","content":"import React from 'react';\nimport ExportHistory from './ExportHistory';\n// Assuming other bank components are imported here\n// import BankList from './BankList';\n// import BankDetails from './BankDetails';\n\nconst BanksRoutesConfig = [\n  // {\n  //   path: '/banks',\n  //   element: <BankList />\n  // },\n  // {\n  //   path: '/banks/:bankId',\n  //   element: <BankDetails />\n  // },\n  {\n    path: '/banks/export-history',\n    element: <ExportHistory />\n  }\n];\n\nexport default BanksRoutesConfig;\n"},"repairedBlock":false,"fileName":"routesConfig.jsx"},{"filePath":"src/core/layouts/appRoutes.jsx","fileContent":"import React from 'react';\nimport { Route, Routes } from 'react-router-dom';\nimport PaymentsRoutesConfig from '../../modules/payments/routesConfig';\nimport BanksRoutesConfig from '../../modules/banks/routesConfig'; // <-- ADD THIS IMPORT\n\n// Assuming other route configs are imported here\n// import CardsRoutes from '../../modules/cards/routesConfig'; \n\nconst AppRoutes = () => {\n  const additionalModuleRoutes = [\n    ...PaymentsRoutesConfig,\n    ...BanksRoutesConfig, // <-- ADD THIS LINE\n    // ...CardsRoutes,\n  ];\n\n  return (\n    <Routes>\n      {/* Other core routes li